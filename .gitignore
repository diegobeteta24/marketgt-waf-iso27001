# ─── Secretos: NUNCA se versionan ─────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
infra/secrets/
duckdns-token.txt
cloudflare-*.ini
*.ovpn

# Los recursos compilados SI se versionan (app/public/build). El servidor de
# produccion no lleva Node: se despliega exactamente lo que se probo, y se
# evita que el compilador de estilos agote la memoria de la maquina.
# Regenerar con:  cd app && npm run build

# Los directorios de trabajo de Laravel (storage, bootstrap/cache) NO se
# excluyen desde aqui: cada uno lleva su propio .gitignore con la convencion
# de Laravel, que ignora el contenido pero conserva el directorio. Excluirlos
# desde la raiz hacia que no viajaran al servidor, y el framework aborta con
# «Please provide a valid cache path» sin decir cual falta.

# ─── Laravel ──────────────────────────────────────────────
app/vendor/
app/node_modules/
app/public/hot
app/public/storage
app/storage/*.key
app/.phpunit.result.cache
app/database/*.sqlite
app/database/*.sqlite-journal
!.gitkeep

# ─── Docker / runtime ─────────────────────────────────────────
infra/docker/data/
infra/docker/volumes/
infra/docker/logs/
*.log
!evidencias/**/*.log

# ─── Node / build ─────────────────────────────────────────────
node_modules/
dist/
.vite/

# ─── Sistema operativo y editores ─────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ─── Respaldos locales ────────────────────────────────────────
*.sql.gz
*.dump
backups/

# Pendiente: requiere scope workflow en el token de gh
.github/workflows/.gitkeep

# Secretos de DNS dinamico (nunca versionados)
infra/secrets/
dns.env

# ─── Archivos de bloqueo de Office ────────────────────────────
# Word y PowerPoint los crean mientras el documento esta abierto. Son basura
# temporal, y ademas llevan el nombre de usuario de quien lo tiene abierto.
~$*
