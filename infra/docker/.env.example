# =============================================================================
# MarketGT - variables de entorno de docker compose
# Copia a infra/docker/.env  (que va en .gitignore) y rellena los secretos.
#   cp infra/docker/.env.example infra/docker/.env
# =============================================================================

# URL publica que verá el profesor (dominio de Cloudflare o del proveedor)
APP_URL=https://marketgt.tudominio.com

# Base de datos (Capa 6)
DB_DATABASE=marketgt
DB_USERNAME=marketgt
DB_PASSWORD=cambia-esto-por-32-caracteres-aleatorios
DB_ROOT_PASSWORD=cambia-esto-tambien-y-que-sea-distinto

# Secreto de la consola de demostracion (regla 1006 del fichero 900).
# Se manda como cabecera:  -H "X-MarketGT-Console: <valor>"
MARKETGT_DEMO_KEY=cambia-este-secreto-largo

# -----------------------------------------------------------------------------
# AVISO SOBRE INTERPOLACION DE DOCKER COMPOSE
# Si alguna vez necesitas fijar a mano una variable de la imagen del WAF cuyo
# valor contiene una variable de nginx (PROXY_HOST_HEADER, NGINX_X_FORWARDED_PORT,
# NGINX_X_FORWARDED_PROTO...), TIENES que duplicar el simbolo del dolar:
#
#   PROXY_HOST_HEADER: "$$host"            # correcto -> nginx recibe $host
#   PROXY_HOST_HEADER: "$host"             # MAL -> compose lo sustituye por vacio
#
# Es el fallo mas comun al montar esta imagen con compose y deja el proxy roto
# sin mensaje de error claro. En este proyecto no las fijamos: usamos los
# valores por defecto de la imagen, que ya son los correctos.
# -----------------------------------------------------------------------------
