# Normaliza los finales de línea. Sin esto, Git en Windows convierte a CRLF
# y los scripts de shell fallan en el servidor Linux con "bad interpreter".
* text=auto eol=lf

*.sh            text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.env           text eol=lf
*.data          text eol=lf
Dockerfile*     text eol=lf
*.md            text eol=lf
*.php           text eol=lf
*.blade.php     text eol=lf

# Binarios: nunca tocar
*.pdf           binary
*.png           binary
*.jpg           binary
*.ico           binary
*.woff2         binary
